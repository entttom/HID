[Unit]
Description=PiKVM HID Automation
After=network-online.target kvmd.service
Wants=network-online.target
Requires=kvmd.service

[Service]
Type=simple
WorkingDirectory=/opt/hid-automation
EnvironmentFile=/etc/hid-automation.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python /opt/hid-automation/server.py
Restart=on-failure
RestartSec=3

# The launcher needs root only for short kvmd-pstrun persistent-storage writes.
# HID requests are executed as the dedicated hid-automation user via runuser.
User=root
Group=root

# With explicit User=root under NoNewPrivileges=true, systemd does not grant
# the process the legacy "euid=0 gets full bounding set" capability regrant,
# so CAP_SETUID/CAP_SETGID would be missing from the effective set and every
# runuser call into the hid-automation user fails with "cannot set user id:
# Operation not permitted". Ambient capabilities restore exactly what runuser
# needs without granting anything broader.
AmbientCapabilities=CAP_SETUID CAP_SETGID

# PrivateTmp/ProtectHome/ProtectKernelTunables/ProtectKernelModules/
# ProtectControlGroups each require systemd to give this unit its own mount
# namespace. Once isolated that way, the dynamic "mount -o remount,rw" that
# kvmd-pst performs on /var/lib/kvmd/pst for each kvmd-pstrun session never
# becomes visible inside the unit's namespace: kvmd-pstrun reports "PST write
# is allowed" but the actual write then fails with "Read-only file system",
# so state persistence breaks silently. Verified empirically that any of
# these directives alone is fine, but combining more than ~2 forces the
# isolated-namespace path even for paths they don't otherwise touch - so
# they're dropped entirely rather than kept as a fragile, undocumented-limit
# partial set.
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
